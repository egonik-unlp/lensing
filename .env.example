# OpenAI API key for embedding manual entries (required for POST /api/listings)
OPENAI_API_KEY=
#
# Infra knobs (read by docker compose AND by `zig build`, so they always agree):
# LENSING_DB_PORT=5433            # host port for the Postgres metadata DB
# LENSING_DB_USER=lensing
# LENSING_DB_PASSWORD=lensing
# LENSING_DB_NAME=lensing
# LENSING_QDRANT_CONTAINER=       # docker container holding the Qdrant corpus;
#                                 # `zig build serve` starts it if it's down
# QDRANT_URL=http://localhost:6333
