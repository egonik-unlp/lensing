# Copy to the repo root as `.env` (docker compose, build.zig and
# scripts/ensure-qdrant.sh all read it there):
#   cp docker/.env.example .env
# Then seed the deploy identity from domain.toml:
#   python3 scripts/render-deploy-env.py --write
#
# Process-env values always win over this file.

# ---- Instance identity -----------------------------------------------------
# Prefixes container/network/volume names so multiple instances coexist on one
# host without colliding (D1). Derived from domain.toml [project].name /
# [deploy].compose_project by scripts/render-deploy-env.py.
COMPOSE_PROJECT_NAME=lensing

# ---- Images ----------------------------------------------------------------
LENSING_IMAGE=lensing-runtime
LENSING_INFER_IMAGE=lensing-infer
LENSING_TAG=latest

# ---- Metadata database (Postgres) ------------------------------------------
LENSING_DB_USER=pg
LENSING_DB_PASSWORD=pg
LENSING_DB_NAME=lensing
# HOST-side port (container port is always 5432). Bump per instance to avoid
# collisions on a shared host.
LENSING_DB_PORT=5433

# ---- Corpus (Qdrant) -------------------------------------------------------
# Internal URL the hub/infer use over the compose network. Point at an external
# Qdrant here for multi-host, or use the bundled `qdrant` profile locally.
LENSING_QDRANT_URL=http://qdrant:6333
LENSING_QDRANT_PORT=6333
LENSING_QDRANT_GRPC_PORT=6334
# If ensure-qdrant.sh should start an external container for `zig build serve`:
# LENSING_QDRANT_CONTAINER=

# ---- Server roles ----------------------------------------------------------
# HOST-side ports (container ports are fixed: hub 8080, infer 8090).
LENSING_HUB_PORT=8080
LENSING_INFER_PORT=8090
# Hub runs the idempotent migrate-data backfill before serving on a clean DB.
LENSING_MIGRATE_ON_START=true

# ---- Multi-host (split across machines) ------------------------------------
# On a WORKER or INFER machine, point these at the hub machine (not localhost):
# LENSING_HUB_URL=http://hub-host:8080
# DATABASE_URL=postgres://pg:pg@hub-host:5433/lensing
# LENSING_POLL_SECS=10
